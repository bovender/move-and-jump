{
  "name": "move-and-jump",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Thunderbird add-on: type-ahead search to move emails to a folder, or jump to one.",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "start": "web-ext run -c web-ext-config.cjs --firefox-binary thunderbird",
    "build": "web-ext build -c web-ext-config.cjs --filename \"move-and-jump-{version}.xpi\"",
    "lint": "web-ext lint -c web-ext-config.cjs",
    "test": "node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "web-ext": "^10.5.0"
  }
}
